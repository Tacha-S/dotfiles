#!/bin/bash -eu

declare -A ROS2_LTS_BY_UBUNTU=(
    [focal]="foxy"       # 20.04
    [jammy]="humble"     # 22.04
    [noble]="jazzy"      # 24.04
    [resolute]="lyrical" # 26.04
)

. /etc/os-release
CODENAME="${1:-${UBUNTU_CODENAME:-${VERSION_CODENAME:-}}}"

if [ -z "${ROS2_LTS_BY_UBUNTU[$CODENAME]:-}" ]; then
    exit 1
fi

ROS_APT_SOURCE_VERSION=$(curl -s https://api.github.com/repos/ros-infrastructure/ros-apt-source/releases/latest | grep -F "tag_name" | awk -F'"' '{print $4}')
curl -L -o /tmp/ros2-apt-source.deb "https://github.com/ros-infrastructure/ros-apt-source/releases/download/${ROS_APT_SOURCE_VERSION}/ros2-apt-source_${ROS_APT_SOURCE_VERSION}.$(. /etc/os-release && echo ${UBUNTU_CODENAME:-${VERSION_CODENAME}})_all.deb"
sudo dpkg -i /tmp/ros2-apt-source.deb

DISTRO=${ROS2_LTS_BY_UBUNTU[$CODENAME]}

sudo apt update && sudo apt install -y ros-dev-tools ros-${DISTRO}-desktop ros-${ROS_DISTRO}-rmw-cyclonedds-cpp ros-${ROS_DISTRO}-rmw-zenoh-cpp

colcon mixin add default https://raw.githubusercontent.com/colcon/colcon-mixin-repository/master/index.yaml
colcon mixin update default

sudo cp {{ .chezmoi.sourceDir }}/etc_files/multicast-lo.service /etc/systemd/system/multicast-lo.service

sudo systemctl daemon-reload
sudo systemctl enable multicast-lo.service
sudo systemctl start multicast-lo.service

sudo cp {{ .chezmoi.sourceDir }}/etc_files/10-cyclone-max.conf /etc/sysctl.d/10-cyclone-max.conf
